---
import Layout from '../layouts/Layout.astro';
import MenuButton from '../components/MenuButton.jsx';
import { motion } from 'framer-motion';
---

<Layout title="404 - Page Not Found | Jean Roa">
  <MenuButton client:load />
  <main class="flex flex-col min-h-screen bg-[#0e0e16]">
    <div class="container mx-auto px-4 py-8 flex flex-col items-center justify-center min-h-screen relative overflow-hidden">
      
      <!-- Background grid effect -->
      <div class="absolute inset-0 bg-grid-pattern opacity-30"></div>
      
      <!-- Content -->
      <div class="text-center relative z-10 max-w-4xl mx-auto px-4">
        <motion.h1 
          className="font-squada text-white text-8xl md:text-9xl glitch-text"
          initial={{ y: -50, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
          transition={{ duration: 0.8, ease: "easeOut" }}
          client:load
        >
          404
        </motion.h1>
        
        <motion.h2
          className="font-squada text-purple-500 text-4xl md:text-5xl mt-4 mb-8"
          initial={{ y: 50, opacity: 0 }}
          animate={{ y: 0, opacity: 1 }}
          transition={{ duration: 0.8, delay: 0.2, ease: "easeOut" }}
          client:load
        >
          PAGE NOT FOUND
        </motion.h2>
        
        <motion.p
          className="text-zinc-400 text-xl mb-12 max-w-2xl mx-auto"
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ duration: 1, delay: 0.4 }}
          client:load
        >
          The page you're looking for doesn't exist or has been moved.
          Return to the homepage.
        </motion.p>
        
        <motion.div
          initial={{ scale: 0.9, opacity: 0 }}
          animate={{ scale: 1, opacity: 1 }}
          transition={{ duration: 0.5, delay: 0.6 }}
          client:load
        >
          <a 
            href="/" 
            class="inline-block px-8 py-4 bg-purple-700 text-white text-xl font-semibold rounded-lg hover:bg-purple-800 transition-all duration-300 transform hover:scale-105 relative overflow-hidden button-hover-effect purple-glow"
          >
            <span class="relative z-10">BACK TO HOME</span>
          </a>
        </motion.div>
      </div>

      <!-- Decorative elements -->
      <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-purple-700/20 rounded-full filter blur-3xl"></div>
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-indigo-700/20 rounded-full filter blur-3xl"></div>
    </div>
  </main>
</Layout>

<style>
  .bg-grid-pattern {
    background-image: linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 30px 30px;
  }

  .glitch-text {
    position: relative;
    text-shadow: 0.05em 0 0 rgba(255, 0, 255, 0.75),
                -0.025em -0.05em 0 rgba(0, 255, 255, 0.75),
                0.025em 0.05em 0 rgba(255, 255, 0, 0.75);
    animation: glitch 2s infinite;
  }

  @keyframes glitch {
    0% {
      text-shadow: 0.05em 0 0 rgba(255, 0, 255, 0.75),
                  -0.025em -0.05em 0 rgba(0, 255, 255, 0.75),
                  0.025em 0.05em 0 rgba(255, 255, 0, 0.75);
    }
    14% {
      text-shadow: 0.05em 0 0 rgba(255, 0, 255, 0.75),
                  -0.025em -0.05em 0 rgba(0, 255, 255, 0.75),
                  0.025em 0.05em 0 rgba(255, 255, 0, 0.75);
    }
    15% {
      text-shadow: -0.05em -0.025em 0 rgba(255, 0, 255, 0.75),
                  0.025em 0.025em 0 rgba(0, 255, 255, 0.75),
                  -0.05em -0.05em 0 rgba(255, 255, 0, 0.75);
    }
    49% {
      text-shadow: -0.05em -0.025em 0 rgba(255, 0, 255, 0.75),
                  0.025em 0.025em 0 rgba(0, 255, 255, 0.75),
                  -0.05em -0.05em 0 rgba(255, 255, 0, 0.75);
    }
    50% {
      text-shadow: 0.025em 0.05em 0 rgba(255, 0, 255, 0.75),
                  0.05em 0 0 rgba(0, 255, 255, 0.75),
                  0 -0.05em 0 rgba(255, 255, 0, 0.75);
    }
    99% {
      text-shadow: 0.025em 0.05em 0 rgba(255, 0, 255, 0.75),
                  0.05em 0 0 rgba(0, 255, 255, 0.75),
                  0 -0.05em 0 rgba(255, 255, 0, 0.75);
    }
    100% {
      text-shadow: -0.025em 0 0 rgba(255, 0, 255, 0.75),
                  -0.025em -0.025em 0 rgba(0, 255, 255, 0.75),
                  -0.025em -0.05em 0 rgba(255, 255, 0, 0.75);
    }
  }

  /* Button hover effect styles are already in global.css */
</style> 