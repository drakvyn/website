---
import Layout from '../../layouts/Layout.astro';
import { getBlogPosts, getBlogPostBySlug } from '../../lib/sanity/client';
import { format } from 'date-fns';
import MenuButton from '../../components/MenuButton.jsx';

// Define el tipo de post
interface BlogPost {
  _id: string;
  title: string;
  slug: { current: string };
  publishedAt: string;
  excerpt?: string;
  mainImage?: { asset: { _id: string; url: string } };
  body?: any;
  description?: string;
  keywords?: string[];
}

// Definir tipos para Portable Text
interface BlockChild {
  _type: string;
  text?: string;
  marks?: string[];
}

interface ContentBlock {
  _type: string;
  style?: string;
  listItem?: string;
  children?: BlockChild[];
  markDefs?: Array<{
    _type: string;
    _key: string;
    href: string;
  }>;
  asset?: {
    url: string;
  };
  alt?: string;
}

// Get all slugs to generate static pages
export async function getStaticPaths() {
  const posts = await getBlogPosts(100, 0);
  return posts.map((post: BlogPost) => ({
    params: { slug: post.slug.current },
    props: { post },
  }));
}

// If it's a dynamic page, get the data
const { slug } = Astro.params;
let { post } = Astro.props as { post?: BlogPost };

// If we don't have the full post (like when accessing the URL directly), get it
if (!post || !post.body) {
  post = await getBlogPostBySlug(slug);
}

// Format the date
const formattedDate = post && post.publishedAt ? 
  format(new Date(post.publishedAt), "MMMM dd, yyyy") : 
  '';

// SEO description
const description = post?.description || post?.excerpt || (post?.title ? `Article about ${post.title}` : 'Blog article');
const keywords = post?.keywords?.join(', ') || 'blog, article, technology';

// SEO metadata
const title = post ? `${post.title} | Jean Roa` : 'Blog Post | Jean Roa';
const ogImage = post?.mainImage?.asset?.url || '';
const publishedTime = post?.publishedAt || '';

// Función para renderizar contenido de Portable Text
function renderPortableText(blocks: ContentBlock[]): string {
  if (!blocks || !Array.isArray(blocks)) return '';
  
  let html = '';
  blocks.forEach(block => {
    if (block._type === 'block') {
      let text = '';
      if (block.children && Array.isArray(block.children)) {
        block.children.forEach((child: BlockChild) => {
          if (child._type === 'span') {
            // Aplicar estilos si hay marcas
            if (child.marks && child.marks.length > 0) {
              let styledText = child.text || '';
              
              // Buscar enlaces en markDefs
              const linkMarks = child.marks.filter(mark => 
                block.markDefs?.some(def => def._key === mark && def._type === 'link')
              );
              
              // Si es un enlace, obtener la URL
              if (linkMarks.length > 0) {
                linkMarks.forEach(linkKey => {
                  const linkDef = block.markDefs?.find(def => def._key === linkKey);
                  if (linkDef && linkDef.href) {
                    const rel = linkDef.href.startsWith('/') ? '' : 'rel="noopener noreferrer"';
                    styledText = `<a href="${linkDef.href}" ${rel} class="text-purple-500 hover:text-purple-400" target="_blank">${styledText}</a>`;
                  }
                });
              }
              
              // Procesar otras marcas
              child.marks.forEach((mark: string) => {
                // Ignorar marcas que ya se procesaron como enlaces
                if (!linkMarks.includes(mark)) {
                  if (mark === 'strong') {
                    styledText = `<strong>${styledText}</strong>`;
                  } else if (mark === 'em') {
                    styledText = `<em>${styledText}</em>`;
                  } else if (mark === 'code') {
                    styledText = `<code>${styledText}</code>`;
                  } else if (mark === 'underline') {
                    styledText = `<u>${styledText}</u>`;
                  }
                }
              });
              
              text += styledText;
            } else {
              text += child.text || '';
            }
          }
        });
      }
      
      // Aplicar estilos basados en block.style
      if (block.style === 'h1') {
        html += `<h1 class="text-3xl font-bold my-4">${text}</h1>`;
      } else if (block.style === 'h2') {
        html += `<h2 class="text-2xl font-bold my-3">${text}</h2>`;
      } else if (block.style === 'h3') {
        html += `<h3 class="text-xl font-bold my-2">${text}</h3>`;
      } else if (block.style === 'h4') {
        html += `<h4 class="text-lg font-bold my-2">${text}</h4>`;
      } else if (block.style === 'blockquote') {
        html += `<blockquote class="pl-4 border-l-4 border-purple-500 italic my-4">${text}</blockquote>`;
      } else if (block.listItem === 'bullet') {
        html += `<li class="ml-6">${text}</li>`;
      } else if (block.listItem === 'number') {
        html += `<li class="ml-6 list-decimal">${text}</li>`;
      } else {
        html += `<p class="my-4">${text}</p>`;
      }
    } else if (block._type === 'image' && block.asset) {
      html += `<img src="${block.asset.url}" alt="${block.alt || ''}" class="rounded-lg my-6 w-full" />`;
    }
  });
  
  // Procesar listas correctamente agrupando elementos li
  html = html.replace(/<li class="ml-6">(.*?)<\/li>/g, (match, p1) => {
    if (!html.includes('<ul>')) {
      return `<ul class="list-disc my-4">${match}</ul>`;
    }
    return match;
  });
  
  html = html.replace(/<li class="ml-6 list-decimal">(.*?)<\/li>/g, (match, p1) => {
    if (!html.includes('<ol>')) {
      return `<ol class="list-decimal my-4">${match}</ol>`;
    }
    return match;
  });
  
  return html;
}
---

<Layout title={title}>
  <!-- SEO Meta Tags -->
  <meta name="description" content={description} slot="head" />
  <meta name="keywords" content={keywords} slot="head" />
  
  <meta property="og:title" content={title} slot="head" />
  <meta property="og:description" content={description} slot="head" />
  {ogImage && <meta property="og:image" content={ogImage} slot="head" />}
  <meta property="og:type" content="article" slot="head" />
  {publishedTime && <meta property="article:published_time" content={publishedTime} slot="head" />}

  <MenuButton client:load />
  <div class="min-h-screen bg-[#0e0e16]">
    <!-- Back to Home Button -->
    <div class="container mx-auto px-4 pt-8">
      <a href="/" class="inline-flex items-center text-purple-500 hover:text-purple-400 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
    </div>

    {post ? (
      <article class="container mx-auto px-4 pt-32 pb-20">
        <div class="max-w-4xl mx-auto">
          {post.mainImage && post.mainImage.asset && (
            <div class="w-full h-[300px] md:h-[500px] rounded-xl overflow-hidden mb-12 shadow-xl">
              <img 
                src={post.mainImage.asset.url} 
                alt={post.title}
                class="w-full h-full object-cover"
              />
            </div>
          )}
          
          <div class="mb-10">
            <h1 class="font-squada text-white text-4xl md:text-6xl mb-6 tracking-wide">{post.title}</h1>
            <div class="flex flex-wrap items-center gap-4 text-zinc-400">
              <span class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {formattedDate}
              </span>
            </div>
          </div>
          
          <div class="prose prose-invert prose-lg max-w-none">
            {post.body && (
              <div set:html={renderPortableText(post.body)} />
            )}
            {!post.body && (
              <p class="text-zinc-400">This article has no available content.</p>
            )}
          </div>
          
          <div class="mt-16 pt-8 border-t border-zinc-800">
            <a href="/blog" class="flex items-center text-purple-500 hover:text-purple-400 transition-colors font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
              </svg>
              Back to all articles
            </a>
          </div>
        </div>
      </article>
    ) : (
      <div class="container mx-auto px-4 py-32 text-center">
        <h1 class="font-squada text-white text-5xl mb-6">Article not found</h1>
        <p class="text-zinc-400 mb-8">Sorry, we couldn't find the article you're looking for.</p>
        <a href="/blog" class="inline-block px-6 py-3 bg-purple-700 text-white rounded-lg hover:bg-purple-800 transition-colors">
          Return to blog
        </a>
      </div>
    )}
  </div>
</Layout>

<style>
  /* Styles for blog content (PortableText) */
  :global(.prose h2) {
    font-family: 'Squada One', sans-serif;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 2rem;
    line-height: 1.2;
  }
  
  :global(.prose h3) {
    font-family: 'Squada One', sans-serif;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
  }
  
  :global(.prose p) {
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }
  
  :global(.prose a) {
    color: #8b5cf6;
    text-decoration: underline;
    transition: color 0.2s;
  }
  
  :global(.prose a:hover) {
    color: #a78bfa;
  }
  
  :global(.prose ul) {
    list-style-type: disc;
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  :global(.prose ol) {
    list-style-type: decimal;
    margin-left: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  :global(.prose img) {
    border-radius: 0.5rem;
    margin: 2rem 0;
  }
  
  :global(.prose pre) {
    background-color: #1e1e2e;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  
  :global(.prose code) {
    color: #a78bfa;
    background-color: #1e1e2e;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
</style> 