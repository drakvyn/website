---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard';
import { getBlogPosts } from '../../lib/sanity/client';

// Recuperar todos los posts del blog
const posts = await getBlogPosts(100, 0);
---

<Layout title="Blog - Jean Roa">
    <div class="container mx-auto px-4 py-12 md:py-20">
        <div class="text-center mb-12">
            <h1 class="font-squada text-white text-5xl sm:text-6xl md:text-7xl lg:text-8xl mb-6 tracking-wide">BLOG</h1>
            <p class="text-zinc-400 max-w-2xl mx-auto text-base md:text-lg">
                Artículos, tutoriales, y recursos sobre desarrollo web, diseño, y tecnología.
            </p>
        </div>

        {posts && posts.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                {posts.map((post) => (
                    <BlogCard post={post} />
                ))}
            </div>
        ) : (
            <div class="text-center py-20">
                <p class="text-zinc-400 text-lg">No hay artículos de blog disponibles por el momento.</p>
            </div>
        )}
    </div>
</Layout> 