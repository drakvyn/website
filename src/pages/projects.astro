---
import Layout from '../layouts/Layout.astro';
import MenuButton from '../components/MenuButton.jsx';
import AllProjectsSection from '../components/AllProjectsSection.jsx';
---

<Layout title="Projects | Jean Roa - Software Developer">
  <MenuButton client:load />
  <main class="flex flex-col min-h-screen bg-[#0e0e16]">
    <!-- Hero Section with Back Button -->
    <div class="relative h-[30vh] flex items-center justify-center">
      <!-- Back Button -->
      <div class="fixed top-6 left-6 z-40">
        <a href="/" class="inline-flex items-center px-3 py-1.5 md:px-4 md:py-2 bg-white text-[#1F1B24] rounded-lg shadow-lg hover:bg-zinc-100 transition-all duration-300 group text-sm md:text-base">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 md:h-5 md:w-5 mr-1.5 md:mr-2 transform transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Home
        </a>
      </div>

      <!-- Title -->
      <div class="text-center relative z-10">
        <h1 class="text-overlay font-squada text-white text-5xl sm:text-6xl md:text-7xl tracking-wide mb-6">PROJECTS</h1>
        <p class="text-zinc-400 max-w-2xl mx-auto text-lg px-4">
          Browse through my complete portfolio of web development and design projects
        </p>
      </div>
    </div>

    <!-- Projects Section -->
    <div class="container mx-auto px-4 py-12">
      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <AllProjectsSection client:load />
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Project card animations */
  :global(.project-card) {
    position: relative;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(24, 24, 36, 0.5);
    backdrop-filter: blur(10px);
  }

  :global(.project-card:hover) {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  :global(.project-image-container) {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
  }

  :global(.project-image-container img) {
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.project-card:hover .project-image-container img) {
    transform: scale(1.05);
  }

  /* Content overlay */
  :global(.project-content) {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(14, 14, 22, 0.95),
      rgba(14, 14, 22, 0.7) 30%,
      transparent
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
  }

  :global(.project-card:hover .project-content) {
    opacity: 1;
  }

  /* Decorative elements */
  :global(.project-card::before) {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    pointer-events: none;
  }

  :global(.project-card::after) {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.1), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  :global(.project-card:hover::after) {
    opacity: 1;
  }
</style> 