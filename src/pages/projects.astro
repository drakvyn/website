---
import Layout from '../layouts/Layout.astro';
import MenuButton from '../components/MenuButton.jsx';
import AllProjectsSection from '../components/AllProjectsSection.jsx';
---

<Layout title="Projects | Jean Roa - Software Developer">
  <MenuButton client:load />
  <main class="flex flex-col min-h-screen bg-[#0e0e16]">
    <!-- Back to Home Button -->
    <div class="container mx-auto px-4 pt-8">
      <a href="/" class="inline-flex items-center text-purple-500 hover:text-purple-400 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
    </div>

    <!-- Hero Section -->
    <div class="container mx-auto px-4 py-8 pt-32">
      <div class="text-center mb-16">
        <h1 class="text-overlay font-squada text-white text-5xl sm:text-6xl md:text-8xl mb-6 tracking-wide">PROJECTS</h1>
        <p class="text-zinc-400 max-w-2xl mx-auto text-lg">
          Browse through my complete portfolio of web development and design projects
        </p>
      </div>

      <!-- Projects Grid -->
      <div class="columns-1 md:columns-2 lg:columns-2 gap-8">
        <AllProjectsSection client:load />
      </div>
    </div>
  </main>
</Layout>

<style>
  /* Project card animations */
  :global(.project-card) {
    break-inside: avoid;
    margin-bottom: 2rem;
    transition: all 0.3s ease;
    border-radius: 1rem;
    overflow: hidden;
    background: rgba(24, 24, 36, 0.5);
    backdrop-filter: blur(10px);
  }

  :global(.project-card:hover) {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(139, 92, 246, 0.2);
  }

  :global(.project-image-container) {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
  }

  :global(.project-image-container img) {
    transition: transform 0.5s ease;
  }

  :global(.project-card:hover .project-image-container img) {
    transform: scale(1.05);
  }

  /* Gradient overlay */
  :global(.project-overlay) {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(14, 14, 22, 0.95),
      rgba(14, 14, 22, 0.6) 50%,
      transparent
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.project-card:hover .project-overlay) {
    opacity: 1;
  }

  /* Filter button animations */
  button {
    position: relative;
    overflow: hidden;
  }

  button::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }

  button:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style> 