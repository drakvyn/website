---
import '../styles/global.css';
import Footer from '../components/Footer.jsx';
import ContactSection from '../components/ContactSection.jsx';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
}

const { title, description, keywords, image } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {image && <meta property="og:image" content={image} />}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Squada+One&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-G56JRG2P1Q"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-G56JRG2P1Q');
    </script>
  </head>
  <body class="min-h-screen bg-background font-manrope text-zinc-100">
    <slot />
    <ContactSection client:load />
    <Footer client:load />
  </body>
</html>

<style is:global>
  :root {
    --font-squada: 'Squada One', cursive;
    --font-manrope: 'Manrope', sans-serif;
  }

  body {
    font-family: var(--font-manrope);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-squada);
  }
</style> 